<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', display: 'flex', flexDirection: 'column' }}>
  <Box style={{ height: 64, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 24, paddingRight: 24 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>Three indices agree: k = 5</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.8 }}>05 · Model selection</Text>
  </Box>

  <Box style={{ marginTop: 28, flexDirection: 'row', gap: 36 }}>
    <Box style={{ width: 740, flexDirection: 'column', gap: 10 }}>
      <Image src="assets/k_selection.png" style={{ width: 740, height: 280, objectFit: 'contain' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', lineHeight: 1.4 }}>Left: within-cluster sum of squares falls steeply to five and then flattens. Right: mean silhouette coefficient over k = 2…10.</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 22, justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'column', gap: 2 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'flex-end', gap: 8 }}>
          <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>0.555</Text>
          <Text style={{ fontSize: 16, color: '#8B97A8', marginBottom: 4 }}>peak</Text>
        </Box>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>Silhouette at k = 5; 0.540 at k = 6</Text>
      </Box>

      <Box style={{ flexDirection: 'column', gap: 2 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>0.572</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>Davies–Bouldin, its minimum</Text>
      </Box>

      <Box style={{ flexDirection: 'column', gap: 2 }}>
        <Text style={{ fontSize: 48, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1 }}>248.6</Text>
        <Text style={{ fontSize: 16, color: '#4A5568' }}>CH at k = 5 (peaks at 9 — secondary)</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ marginTop: 26, background: '#E8EFF8', borderLeft: '4px solid #1E4FA8', padding: '18px 24px' }}>
    <Text style={{ fontSize: 20, color: '#1A2230', lineHeight: 1.5 }}><span style={{ fontWeight: 'bold' }}>k = 5 is not a preference.</span> Silhouette and DB peak there, the elbow agrees; CH favours finer partitions and peaks at 9, so we treat it as secondary.</Text>
  </Box>


  <Box style={{ position: 'absolute', top: 686, left: 0, width: 1160, flexDirection: 'row', justifyContent: 'flex-end' }}>
    <Text style={{ fontSize: 13, color: '#8B97A8' }}>05 / 12</Text>
  </Box>
</Slide>
