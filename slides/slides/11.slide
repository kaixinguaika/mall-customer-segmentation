      <Text style={{ flex: 1, fontSize: 15, color: '#1A2230', lineHeight: 1.4 }}>C. Cortes and V. Vapnik, “Support-vector networks,” <span style={{ fontWeight: 'bold' }}>Machine Learning</span>, vol. 20, no. 3, pp. 273–297, 1995.</Text>
    </Box>

    <Box style={{ flexDirection: 'row', gap: 14, paddingTop: 8, paddingBottom: 8, borderBottom: '1px solid #D6DCE5' }}>
