<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: '60px', display: 'flex', flexDirection: 'column' }}>
  <Box style={{ height: 64, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingLeft: 24, paddingRight: 24 }}>
    <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>Five segments, one map</Text>
    <Text style={{ fontSize: 16, color: '#FFFFFF', opacity: 0.8 }}>07 · Result</Text>
  </Box>

  <Box style={{ marginTop: 28, flexDirection: 'row', gap: 40 }}>
    <Box style={{ width: 400, flexDirection: 'column', gap: 10 }}>
      <Image src="assets/segments.png" style={{ width: 400, height: 392, objectFit: 'contain' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', lineHeight: 1.4 }}>Final partition in the original units; crosses mark the five centroids.</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', gap: 12 }}>
      <Table
        style={{ width: '100%', height: 300 }}
        defaultTextStyle={{ fontSize: 16, textAlign: 'left', color: '#1A2230' }}
        defaultCellStyle={{ border: { bottom: { width: 1, color: '#D6DCE5' } }, padding: '6px 8px' }}
        cells={[
          [
            { text: 'Segment', textStyle: { bold: true, color: '#1E4FA8' } },
            { text: 'n', textStyle: { textAlign: 'right', bold: true, color: '#1E4FA8' } },
            { text: 'Age', textStyle: { textAlign: 'right', bold: true, color: '#1E4FA8' } },
            { text: 'Income (k$)', textStyle: { textAlign: 'right', bold: true, color: '#1E4FA8' } },
            { text: 'Spending', textStyle: { textAlign: 'right', bold: true, color: '#1E4FA8' } },
          ],
          ['C0 Frugal', { text: '23 (11.5%)', textStyle: { textAlign: 'right' } }, { text: '45', textStyle: { textAlign: 'right' } }, { text: '26', textStyle: { textAlign: 'right' } }, { text: '21', textStyle: { textAlign: 'right' } }],
          ['C1 Impulsive', { text: '22 (11.0%)', textStyle: { textAlign: 'right' } }, { text: '25', textStyle: { textAlign: 'right' } }, { text: '26', textStyle: { textAlign: 'right' } }, { text: '79', textStyle: { textAlign: 'right' } }],
          ['C2 Standard', { text: '81 (40.5%)', textStyle: { textAlign: 'right' } }, { text: '43', textStyle: { textAlign: 'right' } }, { text: '55', textStyle: { textAlign: 'right' } }, { text: '50', textStyle: { textAlign: 'right' } }],
          ['C3 Conservative', { text: '35 (17.5%)', textStyle: { textAlign: 'right' } }, { text: '41', textStyle: { textAlign: 'right' } }, { text: '88', textStyle: { textAlign: 'right' } }, { text: '17', textStyle: { textAlign: 'right', color: '#D9534F', bold: true } }],
          ['C4 Target', { text: '39 (19.5%)', textStyle: { textAlign: 'right' } }, { text: '33', textStyle: { textAlign: 'right' } }, { text: '87', textStyle: { textAlign: 'right' } }, { text: '82', textStyle: { textAlign: 'right', color: '#1E4FA8', bold: true } }],
        ]}
      />
      <Text style={{ fontSize: 15, color: '#8B97A8', lineHeight: 1.45 }}>Means per segment; share of the 200 customers in brackets; % female is in the report.</Text>

      <Box style={{ background: '#E8EFF8', borderLeft: '4px solid #1E4FA8', padding: '14px 18px' }}>
        <Text style={{ fontSize: 18, color: '#1A2230', lineHeight: 1.5 }}>C3 and C4 sit at the <span style={{ fontWeight: 'bold' }}>same income</span> and differ by <span style={{ fontWeight: 'bold' }}>65 spending points</span> — income alone would merge the mall's best and worst customers.</Text>
      </Box>
    </Box>
  </Box>

  <Box style={{ position: 'absolute', top: 610, left: 0, width: 1160, flexDirection: 'row', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>Mall Customer Segmentation · Course Project</Text>
    <Text style={{ fontSize: 14, color: '#8B97A8' }}>07 / 11</Text>
  </Box>
</Slide>
